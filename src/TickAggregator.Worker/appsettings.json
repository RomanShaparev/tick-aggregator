{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "MassTransit": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "QueueName": "raw-ticks",
    "BatchMessageLimit": 100,
    "BatchTimeLimitMs": 500,
    "PrefetchCount": 500
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=tickaggregator;Username=postgres;Password=postgres"
  },
  "Deduplication": {
    "TtlSeconds": 300
  },
  "DataSources": [
    {
      "Name": "Binance",
      "Url": "ws://localhost:5100/ws/binance",
      "ReconnectDelayMs": 3000,
      "MaxReconnectDelayMs": 30000
    },
    {
      "Name": "Kraken",
      "Url": "ws://localhost:5100/ws/kraken",
      "ReconnectDelayMs": 3000,
      "MaxReconnectDelayMs": 30000
    },
    {
      "Name": "Bybit",
      "Url": "ws://localhost:5100/ws/bybit",
      "ReconnectDelayMs": 3000,
      "MaxReconnectDelayMs": 30000
    }
  ]
}
